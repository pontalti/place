
# ==========================================
# Build Stage - JDK 27 + Gradle Wrapper
# ==========================================
FROM eclipse-temurin:27-jdk-alpine AS build

WORKDIR /home/app

# Gradle configuration
COPY gradlew .
COPY gradle ./gradle
COPY settings.gradle.kts gradle.properties build.gradle.kts ./

RUN chmod +x ./gradlew

# Application source
COPY src ./src

# Build Quarkus application
RUN ./gradlew clean build \
    --no-daemon \
    --no-configuration-cache


# ==========================================
# Runtime Stage - JRE 27
# ==========================================
FROM eclipse-temurin:27-jre-alpine

WORKDIR /app

# Copy Quarkus fast-jar distribution
COPY --from=build /home/app/build/quarkus-app/ ./

# Application port
EXPOSE 8080

# Run Quarkus
ENTRYPOINT ["java", "-jar", "quarkus-run.jar"]
